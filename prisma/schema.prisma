generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiPersonality {
  id              String   @id @default(cuid())
  key             String   @unique @default("default") // Singleton: apenas 1 registro ativo
  ragPrompt       String   @db.Text
  doctorId        Int?
  doctorName      String?
  doctorCrm       Int?
  doctorSpecialty String?
  updatedBy       String? // ID do usuário que atualizou
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PrescriptionRequest {
  id          String   @id @default(cuid())
  patientName String
  birthDate   String
  unimedCard  String
  address     String
  medications String
  status      String   @default("PENDENTE") // PENDENTE, CONCLUIDO, REJEITADO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiPersonality {
  id              String   @id @default(cuid())
  key             String   @unique @default("default") // Singleton: apenas 1 registro ativo
  ragPrompt       String   @db.Text
  doctorId        Int?
  doctorName      String?
  doctorCrm       Int?
  doctorSpecialty String?
  updatedBy       String? // ID do usuário que atualizou
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PrescriptionRequest {
  id                String   @id @default(cuid())
  patientName       String
  birthDate         String
  unimedCard        String
  address           String
  medications       String
  status            String   @default("PENDENTE") // PENDENTE, CONCLUIDO, REJEITADO
  passarCarteirinha Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WaitlistEntry {
  id                  String    @id @default(cuid())
  patientName         String
  phone               String
  nin                 String?   // CPF
  birthDate           String?
  doctorId            String?
  doctorName          String?
  addressId           String?   @default("1")
  currentBookingId    String?   // ID do agendamento atual se já tiver
  currentBookingDate  DateTime? // Data do agendamento atual (o horário novo DEVE ser anterior a este)
  requestedBeforeDate DateTime? // Data máxima tolerada pelo paciente
  preferredDays       String?   // ex: "SEGUNDA,TERCA" ou "QUALQUER"
  preferredPeriod     String?   @default("QUALQUER") // MANHA, TARDE, QUALQUER
  priority            Int       @default(1) // 3 = URGENTE, 2 = ALTA, 1 = NORMAL
  priorityReason      String?   // Motivo da prioridade (ex: pós-operatório, queixa aguda)
  status              String    @default("AGUARDANDO") // AGUARDANDO, OFERTADO, AGENDADO, EXPIRADO, CANCELADO
  offeredSlot         DateTime? // Horário que foi ofertado
  offeredAt           DateTime? // Quando foi feito o disparo
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, priority, createdAt])
  @@index([phone])
}

model AppointmentConfirmation {
  id                  String    @id @default(cuid())
  bookingId           String
  patientName         String
  phone               String
  doctorName          String
  appointmentDate     DateTime
  notificationType    String    // "48H" ou "24H"
  status              String    @default("ENVIADO") // ENVIADO, CONFIRMADO, CANCELADO, REMARCADO
  responseReceived    String?
  respondedAt         DateTime?
  sentAt              DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([bookingId, notificationType])
  @@index([phone])
  @@index([appointmentDate])
}


